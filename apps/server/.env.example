OPENROUTER_API_KEY=your_openrouter_api_key
EXA_API_KEY=your_exa_api_key
APP_API_KEY=replace_with_a_long_random_shared_secret
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token
# Set to true to immediately disable every endpoint, including /health.
SERVICE_DISABLED=false
# Optional overrides; defaults are google/gemini-2.5-flash-lite.
OPENROUTER_WRITER_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_PARSER_MODEL=google/gemini-2.5-flash-lite
PORT=3000
