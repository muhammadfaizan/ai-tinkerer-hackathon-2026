OPENROUTER_API_KEY=your_openrouter_api_key
EXA_API_KEY=your_exa_api_key
APP_API_KEY=replace_with_a_long_random_shared_secret
# Enables POST /admin/entitlement. Keep this separate from APP_API_KEY.
ADMIN_API_KEY=replace_with_a_separate_long_random_admin_secret
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token
# Set to true to immediately disable every endpoint, including /health.
SERVICE_DISABLED=false
# All five are required before GET /app-version is exposed.
APP_LATEST_VERSION_CODE=1
APP_MIN_VERSION_CODE=1
APP_LATEST_VERSION_NAME=1.0.0
APP_DOWNLOAD_URL=https://example.com/in-tune.apk
APP_RELEASE_NOTES=Initial release
# Optional overrides; defaults are google/gemini-2.5-flash-lite.
OPENROUTER_WRITER_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_PARSER_MODEL=google/gemini-2.5-flash-lite
PORT=3000
